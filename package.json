{
  "name": "copilot-metrics-viewer",
  "version": "3.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run docs:embed && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:e2e": "npx playwright test",
    "docs:dev": "npm run start --prefix website",
    "docs:dev:en": "npm run start:en --prefix website",
    "docs:build": "npm run build --prefix website",
    "docs:embed": "npm run build:embed --prefix website && node website/scripts/embed-in-app-public.mjs",
    "docs:sync-en": "npm run docs:sync-en --prefix website"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.9.0",
    "@nuxt/eslint": "^0.7.4",
    "chart.js": "^4.4.7",
    "date-holidays": "^3.24.4",
    "eslint": "^9.32.0",
    "nuxt": "^3.21.6",
    "nuxt-auth-utils": "^0.5.7",
    "pg": "^8.19.0",
    "roboto-fontface": "^0.10.0",
    "undici": "^7.26.0",
    "unstorage": "^1.17.4",
    "vue": "latest",
    "vue-chartjs": "^5.3.2",
    "vuetify": "^3.7.3",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxt/fonts": "^0.13.0",
    "@nuxt/test-utils": "^3.20.1",
    "@playwright/test": "1.57.0",
    "@types/pg": "^8.18.0",
    "@types/webfontloader": "^1.6.38",
    "@vue/test-utils": "^2.4.6",
    "esbuild": ">=0.25.11",
    "happy-dom": "^20.9.0",
    "pg-mem": "^3.0.14",
    "playwright-core": "1.54.2",
    "sass-embedded": "^1.80.3",
    "typescript": "^5.6.3",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.1.6",
    "vuetify-nuxt-module": "^0.19.5"
  },
  "overrides": {
    "brace-expansion": "^2.0.3",
    "serialize-javascript": "^7.0.5"
  }
