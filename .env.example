# ==============================================================================
# GitHub Copilot Metrics Viewer — example configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
NUXT_PUBLIC_IS_DATA_MOCKED=false
NUXT_PUBLIC_SCOPE=organization
NUXT_PUBLIC_GITHUB_ORG=your-org-name
NUXT_PUBLIC_GITHUB_ENT=your-enterprise-name
NUXT_PUBLIC_GITHUB_TEAM=

# GitHub API base URL (GHE.com): e.g. https://api.SUBDOMAIN.ghe.com
# NUXT_GITHUB_API_BASE_URL=

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
NUXT_GITHUB_TOKEN=
NUXT_SESSION_PASSWORD=change_this_to_a_long_random_string_at_least_32_chars

# Legacy GitHub-only OAuth flag (Menora)
NUXT_PUBLIC_USING_GITHUB_AUTH=false

# Upstream multi-provider auth (comma-separated: github,google,microsoft,auth0,keycloak)
# NUXT_PUBLIC_REQUIRE_AUTH=false
# NUXT_PUBLIC_AUTH_PROVIDERS=github

NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# GitHub App (optional, alternative to PAT)
# NUXT_GITHUB_APP_ID=
# NUXT_GITHUB_APP_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# API / features (upstream)
# ------------------------------------------------------------------------------
USE_LEGACY_API=false
# Server + UI flags for Docker historical mode (postgres + sync)
ENABLE_HISTORICAL_MODE=false
NUXT_PUBLIC_ENABLE_HISTORICAL_MODE=false
# AI adoption cohort panel, chips, and table hints (Organization, Users, Usage & billing, Usage insights).
# Hidden by default — set true when you use CLI, agents, or want GitHub adoption phase labels.
NUXT_PUBLIC_SHOW_AI_ADOPTION_COHORTS=false
# When cohort UI is enabled: show only No cohort + Code first (hides Agent/CLI/multi-agent phases).
NUXT_PUBLIC_ADOPTION_IDE_ONLY=false
NUXT_PUBLIC_HIDDEN_TABS=
NUXT_PUBLIC_ENABLE_AI_CHAT=true
NUXT_PUBLIC_ENTRA_CLIENT_ID=
NUXT_PUBLIC_ENTRA_TENANT_ID=

# ------------------------------------------------------------------------------
# Menora branding & billing
# ------------------------------------------------------------------------------
NUXT_PUBLIC_PREMIUM_CREDITS_FETCH_ENABLED=false
# Per-user AI credits (slow on long ranges / enterprise-owned orgs). Off for Usage & billing speed.
NUXT_PUBLIC_AI_CREDITS_FETCH_ENABLED=false
NUXT_PUBLIC_ENTERPRISE_PREMIUM_QUOTA=1000
# Monthly Copilot seat license (USD) for seat-cost table on Usage & billing / Seat analysis (0 = hide cost columns)
NUXT_PUBLIC_COPILOT_SEAT_UNIT_PRICE=18
NUXT_PUBLIC_DOCS_URL=/docs
# Logo under public/ (e.g. public/brand/menora-logo.png → /brand/menora-logo.png)
NUXT_PUBLIC_BRAND_LOGO_PATH=/brand/menora-logo.png
NUXT_PUBLIC_BRAND_LOGO_ALT=Menora
NUXT_PUBLIC_BRAND_APP_NAME=Copilot Metrics Viewer
NUXT_PUBLIC_BRAND_META_DESCRIPTION=Copilot Metrics Dashboard
NUXT_PUBLIC_BRAND_FOOTER_PROJECT_URL=https://github.com/github-copilot-resources/copilot-metrics-viewer
NUXT_PUBLIC_BRAND_FAVICON_PATH=/brand/menora-logo.png

# ------------------------------------------------------------------------------
# Storage / sync (optional — see upstream docs / docker compose)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://metrics_user:metrics_password@localhost:5432/copilot_metrics
# SYNC_ENABLED=false
# SYNC_SCHEDULE=0 2 * * *
# Extend date picker for long Usage & billing cost windows (months)
# BILLING_LOOKBACK_MONTHS=12
# Cache live GitHub Billing Usage responses (seconds). Default 600.
# BILLING_CACHE_TTL_SECONDS=600
# Year backfill: SYNC_SINCE=2025-07-19 SYNC_UNTIL=2026-07-18 docker compose run --rm sync
# SYNC_SINCE=
# SYNC_UNTIL=
# SYNC_DAYS_BACK=28

# ------------------------------------------------------------------------------
# Network
# ------------------------------------------------------------------------------
# HTTP_PROXY=http://proxy.company.com:8080
# CUSTOM_CA_PATH=/path/to/ca-cert.pem
