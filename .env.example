# Determines if mocked data should be used instead of making API calls.
NUXT_PUBLIC_IS_DATA_MOCKED=false

# Determines the scope of the API calls.
# Can be 'enterprise' or 'organization' to target API calls to an enterprise or an organization respectively.
NUXT_PUBLIC_SCOPE=organization

# Determines the enterprise or organization name to target API calls.
NUXT_PUBLIC_GITHUB_ORG=your-org-name
NUXT_PUBLIC_GITHUB_ENT=your-enterprise-name

# Determines the team name if exists to target API calls.
NUXT_PUBLIC_GITHUB_TEAM=

NUXT_PUBLIC_USING_GITHUB_AUTH=false

# Determines the GitHub Personal Access Token to use for API calls.
# Create with scopes: copilot, manage_billing:copilot or manage_billing:enterprise, read:enterprise AND read:org
NUXT_GITHUB_TOKEN=<YOUR_GITHUB_PAT>

# Must be at least 32 characters — used to encrypt session cookies.
NUXT_SESSION_PASSWORD=change_this_to_a_long_random_string_at_least_32_chars

# For GitHub OAuth (optional)
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Skip per-user premium credits (PRU) billing API calls.
NUXT_PUBLIC_PREMIUM_CREDITS_FETCH_ENABLED=false

# Branding (paths are under `public/` unless you use a full https:// URL)
NUXT_PUBLIC_BRAND_LOGO_PATH=/brand/logo.png
NUXT_PUBLIC_BRAND_LOGO_ALT=Copilot Metrics
NUXT_PUBLIC_BRAND_APP_NAME=Copilot Metrics Viewer
NUXT_PUBLIC_BRAND_META_DESCRIPTION=Copilot Metrics Dashboard
NUXT_PUBLIC_BRAND_FOOTER_PROJECT_URL=https://github.com/github-copilot-resources/copilot-metrics-viewer
NUXT_PUBLIC_BRAND_FAVICON_PATH=/brand/logo.png

# To use a corporate proxy (optional)
# HTTP_PROXY=http://proxy.company.com:8080
